{
  "name": "job-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI Job Copilot - Monorepo Foundation (Phase 1)",
  "workspaces": [
    "frontend",
    "database",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "cd backend && uvicorn main:app --reload --port 8000",
    "dev:all": "concurrently -n \"FE,BE\" -c \"cyan,magenta\" \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "lint:all": "npm run lint --workspace=frontend && cd backend && ruff check .",
    "format": "npm run format --workspace=frontend && cd backend && black .",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && .\\venv\\Scripts\\python.exe -m pytest",
    "test:frontend": "npm run test --workspace=frontend",
    "db:generate": "npm run generate --workspace=database",
    "db:migrate": "npm run migrate:dev --workspace=database",
    "db:seed": "npm run seed --workspace=database",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
