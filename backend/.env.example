# ==============================================================================
# AI Job Copilot - Backend Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI Job Copilot API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="supersecret-change-me-in-production-min-32-chars-long"
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Connection (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/job_copilot_dev"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT=30

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="console" # Options: console, json

# AI Resume Intelligence Engine (Google Gemini)
GEMINI_API_KEY=""
GEMINI_PRIMARY_MODEL="gemini-2.5-pro"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"
AI_REQUEST_TIMEOUT=45
