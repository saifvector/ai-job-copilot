# ==============================================================================
# AI Job Copilot - Monorepo Root Environment Configuration
# ==============================================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_copilot_dev
POSTGRES_PORT=5432

# Backend URL (used by Frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Full Database URLs
# For Prisma CLI (Host machine):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_copilot_dev?schema=public"

# For Backend Async Engine (Host machine):
BACKEND_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/job_copilot_dev"
